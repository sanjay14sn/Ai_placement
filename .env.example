# AI Campus OS - Frontend Environment Variables Example
VITE_API_URL=https://api.aicampusintelligent.com/api
# For local backend testing:
# VITE_API_URL=http://localhost:5030/api

# Resend Email Service (Keep your actual key secret in .env)
RESEND_API_KEY=your_resend_api_key_here
VITE_RESEND_API_KEY=your_resend_api_key_here
VITE_EMAIL_FROM="AI Campus OS <support@aicampusintelligent.com>"

# Razorpay Standard Web Checkout Key ID (Public key for browser)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
